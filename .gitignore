**/target/
.idea
*.iml
*.class
*Test.java
**/test/**
# Track only the isolated customer-service tests; keep existing data-loading tests ignored.
!/src/test/java/
!/src/test/java/com/
!/src/test/java/com/hmdp/
!/src/test/java/com/hmdp/customer/
!/src/test/java/com/hmdp/customer/*Test.java
# Local Nginx runtime. Frontend source is tracked under frontend/hmdp.
/nginx-1.18.0-hmdp/

# Local browser profiles and generated UI previews.
/.codex-chrome-demo/
/docs/customer-service-ui-demo*.png
/docs/customer-service-ui-demo*.jpg
